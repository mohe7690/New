# Get this from @BotFather
BOT_TOKEN=123456:your-telegram-bot-token-here

# Comma-separated numeric Telegram user IDs allowed to see the admin panel
# and approve/reject top-up requests. Message @userinfobot to find your own ID.
ADMIN_IDS=111111111,222222222

# Manual payment accounts shown to users during top-up.
TELEBIRR_NAME=Your Name
TELEBIRR_NUMBER=0911223344
CBE_NAME=Your Name
CBE_ACCOUNT=1000111222333

# Optional: override the default SQLite path.
DB_PATH=data/bot.db
